# ==============================================================================
# Orange Cat Investments (OCI) - 3-Node High-Availability MicroK8s Cluster Inventory
# ==============================================================================
# This inventory configures a resilient 3-node MicroK8s cluster on Ubuntu Server
# with automatic Raft quorum high availability across physical home/office mini PCs.
#
# Quorum Requirement: 3 Control-Plane Server Nodes (Tolerates 1 Node Failure)
# Copy this file to `ha-cluster.ini` and customize IP addresses and interfaces.

[microk8s_primary_server]
node1 ansible_host=192.168.1.201 ansible_user=ramjac

[microk8s_secondary_servers]
node2 ansible_host=192.168.1.202 ansible_user=ramjac
node3 ansible_host=192.168.1.203 ansible_user=ramjac

[microk8s_servers:children]
microk8s_primary_server
microk8s_secondary_servers

[microk8s_cluster:children]
microk8s_servers

[microk8s_cluster:vars]
# Ansible connection settings
ansible_python_interpreter=/usr/bin/python3
ansible_become=true

# High-Availability Virtual IP (VIP) managed by kube-vip (ARP mode)
# This IP must be an unassigned static IP on your local subnet (e.g., 192.168.1.0/24)
cluster_vip=192.168.1.250
cluster_vip_interface=eth0
cluster_vip_cidr=24

# MicroK8s Version Channel
microk8s_channel=1.34/stable
