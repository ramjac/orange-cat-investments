# ==============================================================================
# Forgejo Actions Runner Registration Secret Template
# ==============================================================================
# CRITICAL NOTICE:
# The runner registration token must be obtained from your Forgejo instance.
# To generate a new runner registration token on the cluster:
#   kubectl exec -n oci-internal deploy/forgejo -- forgejo actions generate-runner-token
#
# Then provision this Secret in oci-internal:
#   kubectl create secret generic forgejo-runner-secret \
#     --namespace oci-internal \
#     --from-literal=RUNNER_TOKEN="<OBTAINED-RUNNER-TOKEN>"
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: forgejo-runner-secret
  namespace: oci-internal
  labels:
    app: forgejo-runner
type: Opaque
stringData:
  RUNNER_TOKEN: "REPLACE_WITH_FORGEJO_RUNNER_REGISTRATION_TOKEN"
